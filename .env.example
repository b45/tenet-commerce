# ==============================================================================
# Tenet Commerce - Environment Configuration Template
# ==============================================================================

# Server Environment
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars!
JWT_ACCESS_EXPIRY=900s
JWT_REFRESH_EXPIRY=604800s

# PostgreSQL Database (Multi-Tenant)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=tenet_commerce
DATABASE_SSLMODE=disable
DATABASE_MAX_CONNS=50
DATABASE_MIN_CONNS=10

# Redis (Idempotency Key Store & Distributed Locking)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_IDEMPOTENCY_TTL=86400

# Continuous AI Sharia Auditor Worker
AI_WORKER_CRON="0 2 * * 0"  # Every Sunday at 02:00 AM
AI_WORKER_LOG_LEVEL=INFO

# Gold Spot Price API (for Dynamic Nisab Valuation)
GOLD_PRICE_API_URL=https://api.metals.live/v1/spot/gold
GOLD_PRICE_FALLBACK_PER_GRAM=1350000.00
