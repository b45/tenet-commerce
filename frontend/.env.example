# ==============================================================================
# Tenet Commerce - Frontend Environment Configuration Template
# Copy this file to .env.local for local development
# ==============================================================================

# Target Go Backend API URL (Used by Next.js BFF Route Handlers on the server)
# In local development: http://localhost:8081 (matches backend APP_PORT)
# In container / docker: http://backend:8081
# In production: https://api.tenetcommerce.com
BACKEND_API_URL=http://localhost:8081

# Public Application URL (Used for canonical redirects and CSRF Origin verification)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Branding
NEXT_PUBLIC_APP_NAME="Tenet Commerce"

# Default Tenant Slug (Optional convenience for dev login)
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=b45-bakery
