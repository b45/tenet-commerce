                {
                    "name": "2. POS Checkout (Atomic Inventory Decrement) - SUCCESS",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Generate a fresh idempotency key for this transaction",
                                    "var idempotencyKey = 'idemp_' + Date.now() + '_' + Math.random().toString(36).substring(7);",
                                    "pm.collectionVariables.set(\"last_idempotency_key\", idempotencyKey);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201 Created\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "var jsonData = pm.response.json();",
                                    "pm.test(\"Transaction is COMPLETED\", function () {",
                                    "    pm.expect(jsonData.data.status).to.eql(\"COMPLETED\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Idempotency-Key",
                                "value": "{{last_idempotency_key}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"payment_method\": \"CASH\",\n    \"discount_amount\": 0,\n    \"items\": [\n        {\n            \"sku\": \"{{pos_sample_sku}}\",\n            \"quantity\": 2\n        }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/pos/checkout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "pos",
                                "checkout"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "3. POS Checkout (Duplicate Idempotency Key - Replay from Redis)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201 Created (Cached Replay)\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "var jsonData = pm.response.json();",
                                    "pm.test(\"Same Transaction returned from cache\", function () {",
                                    "    pm.expect(jsonData.data.idempotency_key).to.eql(pm.collectionVariables.get(\"last_idempotency_key\"));",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
